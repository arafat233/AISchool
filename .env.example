# ─── Node ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=school_erp
POSTGRES_USER=school_erp
POSTGRES_PASSWORD=secret_change_in_production
DATABASE_URL=postgresql://school_erp:secret_change_in_production@localhost:5432/school_erp?schema=public&connection_limit=5

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=school-erp
KAFKA_GROUP_ID=school-erp-group

# ─── Auth Service ───────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ISSUER=SchoolERP

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Microsoft OAuth ────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

# ─── User Service ───────────────────────────────────────────────────────────
USER_SERVICE_PORT=3002

# ─── Student Service ────────────────────────────────────────────────────────
STUDENT_SERVICE_PORT=3003

# ─── Academic Service ───────────────────────────────────────────────────────
ACADEMIC_SERVICE_PORT=3004

# ─── Attendance Service ─────────────────────────────────────────────────────
ATTENDANCE_SERVICE_PORT=3005

# ─── Fee Service ────────────────────────────────────────────────────────────
FEE_SERVICE_PORT=3006
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Notification Service ───────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=3007
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SCHOOL
MSG91_TEMPLATE_ID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@schoolerp.com
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
WATI_API_KEY=
WATI_BASE_URL=

# ─── Exam Service ───────────────────────────────────────────────────────────
EXAM_SERVICE_PORT=3008

# ─── Service Communication URLs ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:3007
BIOMETRIC_BRIDGE_URL=http://localhost:8080

# ─── HR Service ─────────────────────────────────────────────────────────────
HR_SERVICE_PORT=3009
# 64-char hex string: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# ─── Payroll Service ────────────────────────────────────────────────────────
PAYROLL_SERVICE_PORT=3010

# ─── Transport Service ──────────────────────────────────────────────────────
TRANSPORT_SERVICE_PORT=3011
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
GOOGLE_MAPS_API_KEY=

# ─── Storage (S3 / R2) ──────────────────────────────────────────────────────
STORAGE_PROVIDER=s3
# AWS SDK vars (used by aws-sdk/client-s3 in some services)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=school-erp-files
# S3-prefixed vars used by user-service avatar upload
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=school-erp-files
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=school-erp-files

# ─── Elasticsearch ──────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── Developer API ──────────────────────────────────────────────────────────
DEVELOPER_API_PORT=3023
# 64-char hex string: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=

# ─── SaaS / API Gateway ─────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
CORS_ORIGINS=http://localhost:4000,http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004
FRONTEND_URL=http://localhost:3100

# ─── Portals ────────────────────────────────────────────────────────────────
ADMIN_PORTAL_PORT=3100
TEACHER_PORTAL_PORT=3101
STUDENT_PORTAL_PORT=3102
PARENT_PORTAL_PORT=3103
COMPANY_PORTAL_PORT=3104

# ─── Puppeteer / PDF ────────────────────────────────────────────────────────
CHROMIUM_PATH=/usr/bin/chromium-browser

# ─── Blockchain ─────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your-key
BLOCKCHAIN_PRIVATE_KEY=
CERTIFICATE_CONTRACT_ADDRESS=
# Private key for signing certificate transactions (64-char hex)
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=school-erp
INFLUXDB_BUCKET=school_erp_metrics

# ─── PII Security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PII_SALT=

# ─── Service Ports (optional overrides) ─────────────────────────────────────
ADMISSION_SERVICE_PORT=3013
CERTIFICATE_SERVICE_PORT=3012
EVENT_SERVICE_PORT=3017
EXPENSE_SERVICE_PORT=3018
HEALTH_SERVICE_PORT=3015
LIBRARY_SERVICE_PORT=3016
LMS_SERVICE_PORT=3009
OPS_SERVICE_PORT=3020
SAAS_SERVICE_PORT=3022
SCHOLARSHIP_SERVICE_PORT=3019

# --- Report / PDF Generation ---
# Path to Chromium/Chrome executable for Puppeteer PDF generation
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# --- Biometric Bridge ---
# Format: DeviceName:IPAddress:Port — comma-separated for multiple devices
BIOMETRIC_DEVICES=MainGate:192.168.1.201:4370
# School identifier for biometric bridge
SCHOOL_ID=

# --- Inter-Service Communication ---
STUDENT_SERVICE_URL=http://localhost:3003
BASE_URL=http://localhost:3000

# --- IoT / Webhooks ---
BMS_WEBHOOK_URL=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- E2E Test Credentials (never use in production) ---
E2E_ADMIN_EMAIL=admin@schoolerp.local
E2E_ADMIN_PASSWORD=Admin@123!
